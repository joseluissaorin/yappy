---
/** Los botones de tienda. Google Play no existe todavía: no se finge. */
import { t, type Idioma } from "../i18n";
import { ENLACES } from "../lib/datos";
interface Props { lang: Idioma; centrado?: boolean }
const { lang, centrado = false } = Astro.props;
---
<div class="acciones" style={centrado ? "justify-content:center" : undefined}>
  <a class="tecla" href={ENLACES.appStore}>{t(lang, "comunes.en_app_store")}</a>
  {ENLACES.googlePlay && <a class="boton" href={ENLACES.googlePlay}>Google Play</a>}
</div>
