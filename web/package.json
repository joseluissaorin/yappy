{
  "name": "@yappy/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "yappy.joseluissaorin.com: la web de Yappy, en 31 idiomas.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
