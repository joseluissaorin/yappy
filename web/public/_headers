# Cloudflare Pages APLICA TODAS las reglas que casan y CONCATENA las
# cabeceras con el mismo nombre. Por eso aquí no se solapan dos reglas de
# Cache-Control sobre la misma ruta: el resultado sería
# «max-age=604800, max-age=0, must-revalidate», que no cachea nada.
# El HTML se queda con el valor por defecto de Pages, que ya es el bueno.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/capturas/*
  Cache-Control: public, max-age=2592000

/audio/*
  Cache-Control: public, max-age=2592000

/muestras/*
  Cache-Control: public, max-age=2592000

/guion/*
  Cache-Control: public, max-age=2592000

# El navegador se niega a compilar un .wasm que no llega con su tipo.
/guion/yappy_wasm_bg.wasm
  Content-Type: application/wasm

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
